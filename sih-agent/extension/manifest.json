{
  "manifest_version": 3,
  "name": "SIH Privacy Browser Agent",
  "version": "0.1.0",
  "description": "Privacy-preserving on-device visual perception for browser agents.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SIH Privacy Agent",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}