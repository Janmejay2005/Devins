{
  "manifest_version": 3,
  "name": "SIH Privacy Browser Agent",
  "version": "0.1.0",
  "description": "Privacy-preserving on-device visual perception for browser agents.",

  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Devins Privacy Browser Agent",
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "assets/devins-16.png",
    "32": "assets/devins-32.png",
    "48": "assets/devins-48.png",
    "128": "assets/devins-128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}